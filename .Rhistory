# Create the table with embedded charts
product_data %>%
mutate(
Mini_Chart = purrr::map(Mini_Chart, ~ as.character(gt::ggplot_image(.x, height = 100, width = 200)))
) %>%
select(Product, Total_Sales, Mini_Chart) %>%
gt() %>%
fmt_currency(columns = "Total_Sales", currency = "USD") %>%
cols_label(
Product = "Product",
Total_Sales = "Total Sales",
Mini_Chart = "Monthly Sales Chart"
) %>%
tab_header(
title = "Sales Performance by Product",
subtitle = "Visualized with Embedded Charts"
)
# Install required packages
install.packages("tidyverse")
install.packages("gt")
install.packages("ggplot2")
# Load libraries
library(tidyverse)
library(gt)
# Example data
product_data <- data.frame(
Product = c("A", "B", "C"),
Total_Sales = c(500000, 300000, 700000),
Monthly_Sales = I(list(
c(50, 60, 70, 80, 90, 100, 50, 60, 70, 80, 90, 100),  # Product A
c(30, 40, 50, 60, 70, 80, 30, 40, 50, 60, 70, 80),    # Product B
c(70, 90, 110, 130, 150, 170, 70, 90, 110, 130, 150, 170) # Product C
))
)
# Function to generate and save mini bar charts as images
create_and_save_mini_chart <- function(monthly_sales, product_name) {
# Create the mini chart
chart <- ggplot(data.frame(Month = 1:12, Sales = monthly_sales), aes(x = Month, y = Sales)) +
geom_col(fill = "steelblue") +
theme_void() +
theme(
plot.margin = margin(0, 0, 0, 0),
axis.text = element_blank(),
axis.ticks = element_blank()
)
# Save the chart as an image
file_name <- paste0("chart_", product_name, ".png")
ggsave(file_name, plot = chart, width = 4, height = 2, dpi = 150)
return(file_name) # Return the file path
}
# Generate and save mini charts
product_data <- product_data %>%
rowwise() %>%
mutate(
Mini_Chart = create_and_save_mini_chart(Monthly_Sales, Product)
)
# Create the table with embedded chart images
product_data %>%
select(Product, Total_Sales, Mini_Chart) %>%
gt() %>%
fmt_currency(columns = "Total_Sales", currency = "USD") %>%
text_transform(
locations = cells_body(columns = "Mini_Chart"),
fn = function(x) {
paste0("<img src='", x, "' style='height:50px;'>")
}
) %>%
cols_label(
Product = "Product",
Total_Sales = "Total Sales",
Mini_Chart = "Monthly Sales Chart"
) %>%
tab_header(
title = "Sales Performance by Product",
subtitle = "Visualized with Embedded Charts"
) %>%
opt_all_caps() %>%
opt_table_font(font = list(google_font("Roboto")))
# Set CRAN mirror
options(repos = c(CRAN = "https://cloud.r-project.org"))
library(ggplot2)
library(dplyr)
# Data
data <- data.frame(
category = c("A", "B", "C", "D", "E"),
value = c(10, 20, 15, 30, 25),
width = c(2, 3, 1, 4, 2)
)
# Calculate cumulative positions for x-axis
data <- data %>%
mutate(
xmin = cumsum(lag(width, default = 0)),
xmax = xmin + width
)
# Update plot titles and labels for Market Share Analysis
ggplot(data) +
geom_rect(aes(
xmin = xmin,
xmax = xmax,
ymin = 0,
ymax = value,
fill = category
)) +
geom_text(aes(
x = (xmin + xmax) / 2,  # Center of each bar
y = value,
label = paste0("$", value, "M")
), vjust = -0.5, size = 4) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Market Share and Revenue Analysis",
x = "Companies",
y = "Revenue (in Millions)"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5),
axis.text.x = element_blank(),  # Remove default x-axis text
axis.ticks.x = element_blank()
)
