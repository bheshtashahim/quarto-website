#####   c) Pie Chart

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required library for reading data
library(readxl)

# Replace with the actual path to your dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Summarize data for the "Occupation" variable
occupation_counts <- table(data$Occupation)

# Set font customizations
par(
  family = "serif",          # Set the font family
  cex.main = 1.5             # Font size for the title
)

# Create a pie chart without labels
pie(
  occupation_counts,
  main = "Distribution of Occupations",
  col = rainbow(length(occupation_counts)), # Use rainbow colors for slices
  labels = NA                                # Remove labels from the slices
)

# Add a legend outside the chart
legend(
  "topleft",                                      # Position the legend
  legend = paste(names(occupation_counts), "(", occupation_counts, ")"), # Legend labels
  fill = rainbow(length(occupation_counts)),      # Colors matching the pie slices
  bty = "n",                                      # Remove legend border
  cex = 0.7                                       # Font size for legend text
)

# Reset graphical parameters to default after plotting
par(family = "arial", cex = 1)

```

#####   d) Boxplot 

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required library for reading data
library(readxl)

# Load dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Remove missing values and select relevant columns
stress_data <- na.omit(data[, c("Occupation", "Stress Level")])

# Adjust graphical parameters to move the x-axis title downward
par(mgp = c(3, 1.5, 0))  # Increase y value to move x-axis title further down

# Create a boxplot using base R graphics
boxplot(
  `Stress Level` ~ factor(Occupation),
  data = stress_data,
  main = "Boxplot of Stress Levels by Occupation",
  xlab = "Occupation",
  ylab = "Stress Level",
  col = "lightcoral",
  border = "black",
  las = 2,  # Rotate x-axis labels for better readability
  cex.axis = 0.8
)

# Reset graphical parameters to default
par(mgp = c(4.0, 1, 0))

```

#####   e) Scatterplot 

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required library for reading data
library(readxl)

# Read in the dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Summarize data for plotting
physical_activity <- data$`Physical Activity Level`
quality_of_sleep <- data$`Quality of Sleep`

# Set font customizations
par(
  family = "serif",    # Set the font family to serif
  cex.main = 1.5,      # Font size for the title
  cex.lab = 1.2,       # Font size for axis labels
  cex.axis = 1        # Font size for axis tick labels
)

# Create a scatter plot with title and customizations
plot(
  physical_activity,
  quality_of_sleep,
  main = "Physical Activity Level vs. Quality of Sleep",
  xlab = "Physical Activity Level",
  ylab = "Quality of Sleep",
  pch = 16,           # Solid circle points
  col = "darkturquoise",       # Color of the points
  cex = 1.2            # Size of the points
)

# Optionally, add a regression line
abline(lm(quality_of_sleep ~ physical_activity), col = "red", lwd = 2)

# Reset graphical parameters
par(family = "serif", cex.main = 1, cex.lab = 1, cex.axis = 1)
```

### Repeat using ggplot2, with your own style. 

####    a) Histogram

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required libraries
library(readxl)
library(ggplot2)

# Replace with the actual path to your dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Create a ggplot2 histogram for "Sleep Duration"
ggplot(data, aes(x = `Sleep Duration`)) +
  geom_histogram(
    binwidth = 0.25, # Adjust binwidth as needed
    fill = "lightblue",
    color = "black"
  ) +
  labs(
    title = "Histogram of Sleep Duration",
    x = "Sleep Duration (hours)",
    y = "Frequency"
  ) +
  theme_minimal() +
  theme(
    text = element_text(size = 14, family = "serif") # Optional: adjust font size and family
  )
```

####    b) Bar Chart 
#####       i. Vertical 

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load necessary libraries
library(ggplot2)
library(readxl)

# Read the dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Summarize the data: calculate average quality of sleep
sleep_summary <- aggregate(data$`Quality of Sleep`, by = list(data$Occupation), FUN = mean, na.rm = TRUE)
colnames(sleep_summary) <- c("Occupation", "Avg_Quality_Sleep")

# Sort the data for better visualization
sleep_summary <- sleep_summary[order(sleep_summary$Avg_Quality_Sleep, decreasing = TRUE), ]

# Create a vertical bar chart
ggplot(sleep_summary, aes(x = reorder(Occupation, -Avg_Quality_Sleep), y = Avg_Quality_Sleep, fill = Occupation)) +
  geom_bar(stat = "identity", color = "black", show.legend = FALSE) +
  labs(
    title = "Average Quality of Sleep by Occupation",
    x = "Occupation",
    y = "Average Quality of Sleep (Scale)"
  ) +
  theme_minimal(base_family = "serif") +
  theme(
    plot.title = element_text(size = 16, face = "bold"),
    axis.title.x = element_text(size = 12),
    axis.title.y = element_text(size = 12),
    axis.text = element_text(size = 10, angle = 45, hjust = 1)
  ) +
  scale_fill_brewer(palette = "Paired")
```

