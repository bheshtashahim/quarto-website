#####   c) Pie Chart

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required libraries
library(readxl)
library(ggplot2)
library(dplyr)

# Load dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Summarize data for the "Occupation" variable
occupation_counts <- data %>%
  count(Occupation) %>%
  mutate(Percentage = round(100 * n / sum(n), 1))

# Ensure all occupations have distinct colors
num_occupations <- nrow(occupation_counts)
custom_colors <- RColorBrewer::brewer.pal(n = min(12, num_occupations), name = "Set3")

# Create the pie chart with ggplot2 (no percentages inside)
ggplot(occupation_counts, aes(x = "", y = n, fill = Occupation)) +
  geom_bar(stat = "identity", width = 1) +
  coord_polar("y") +
  labs(title = "Distribution of Occupations") +
  scale_fill_manual(values = custom_colors, 
                    labels = paste0(occupation_counts$Occupation, " (", occupation_counts$Percentage, "%)")) +
  theme_void() +
  theme(
    text = element_text(family = "serif"),
    plot.title = element_text(size = 20, face = "bold")
  )

```

#####   d) Boxplot 

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load required libraries
