### Create the following charts using only R graphics functions. Be sure to customize the charts with your own style/theme. 

#### The following data is drawn from an existing dataset in which age, gender, and occupation is collected for each individual along with various metrics regarding sleep quality and other health factors. 

####    a) Histogram

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load the dataset in R
library(readxl)
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Create a histogram for "Sleep Duration"
hist(data$`Sleep Duration`,
     main = "Histogram of Sleep Duration",
     xlab = "Sleep Duration (hours)",
     col = "lightblue",
     border = "black",
     breaks = 10)  # Adjust the number of bins as needed

```

####    b) Bar Chart 
#####       i. Vertical 

```{r, echo=FALSE, warning=FALSE, message=FALSE}
# Load necessary library to read data
library(readxl)
library(RColorBrewer)

# Read the dataset
data <- read_excel("~/Library/Mobile Documents/com~apple~Numbers/Documents/Sleep_health_and_lifestyle_dataset.xlsx")

# Summarize the data: calculate average quality of sleep
sleep_summary <- aggregate(data$`Quality of Sleep`, by = list(data$Occupation), FUN = mean, na.rm = TRUE)
colnames(sleep_summary) <- c("Occupation", "Avg_Quality_Sleep")

# Sort the data for better visualization
sleep_summary <- sleep_summary[order(sleep_summary$Avg_Quality_Sleep, decreasing = TRUE), ]

# Set font customizations
par(
  family = "serif",        # Set font family to serif
  cex.main = 1.5,          # Increase title font size
  cex.lab = 1.2,           # Increase axis title font size
  cex.axis = 0.8           # Adjust font size for axis labels
)

# Create a vertical bar chart
barplot(
  sleep_summary$Avg_Quality_Sleep,
  names.arg = sleep_summary$Occupation,
  col = brewer.pal(length(sleep_summary$Occupation), "Dark2"), # Use color scheme for the bars
  main = "Average Quality of Sleep by Occupation",
  xlab = "Occupation",
  ylab = "Average Quality of Sleep (Scale)",
  las = 2,                  # Rotate x-axis labels for better readability
  border = "black",         # Add a border around the bars
  cex.names = 0.8           # Adjust font size for x-axis labels
)

# Reset graphical parameters to defaults
par(family = "sans", cex.main = 1, cex.lab = 1, cex.axis = 1)

```

